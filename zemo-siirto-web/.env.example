# Supabase → Project Settings → API. Both values are public (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Older projects: use the anon key instead
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only secrets (never prefix with NEXT_PUBLIC_) ----
# Supabase → Project Settings → API → service_role / secret key. Used only to record verified payment
# notifications and refunds. Keep it in your hosting provider's secret settings, not in git.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this site, used for Trustly return links and the notification URL.
APP_URL=https://zemosiirto.fi

# ---- Trustly bank payments (leave empty to hide the bank payment button) ----
# test = https://test.trustly.com/api/1, production = https://trustly.com/api/1
TRUSTLY_ENV=test
TRUSTLY_USERNAME=
TRUSTLY_PASSWORD=
# Your RSA private key (PEM). Give the matching PUBLIC key to Trustly. "\n" may be used for line breaks.
TRUSTLY_PRIVATE_KEY=
# Trustly's public key (PEM) for the chosen environment, from Trustly.
TRUSTLY_PUBLIC_KEY=
